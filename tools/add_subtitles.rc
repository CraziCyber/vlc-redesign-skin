#include <windows.h>
#include "add_subtitles.hpp"

IDD_ADD_SUBTITLES DIALOGEX 0, 0, 100, 100
STYLE WS_POPUP | WS_CLIPCHILDREN
EXSTYLE WS_EX_TOOLWINDOW
FONT 11, "Segoe UI"
BEGIN
    CONTROL "To This File", IDC_SUBTITLE_TARGET, "BUTTON", WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_OWNERDRAW, 0, 0, 80, 16
    CONTROL "", IDC_SUBTITLE_TARGET_OPTIONS, "LISTBOX", WS_CHILD | WS_TABSTOP | LBS_HASSTRINGS | LBS_OWNERDRAWFIXED | LBS_NOINTEGRALHEIGHT, 0, 0, 80, 48
    CONTROL "From Computer", IDC_SUBTITLE_SOURCE, "BUTTON", WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_OWNERDRAW, 0, 0, 80, 16
    CONTROL "", IDC_SUBTITLE_SOURCE_OPTIONS, "LISTBOX", WS_CHILD | WS_TABSTOP | LBS_HASSTRINGS | LBS_OWNERDRAWFIXED | LBS_NOINTEGRALHEIGHT, 0, 0, 80, 48
    CONTROL "", IDC_SUBTITLE_QUERY, "EDIT", WS_CHILD | WS_TABSTOP | ES_AUTOHSCROLL, 0, 0, 80, 16
    CONTROL "English", IDC_SUBTITLE_LANGUAGE, "BUTTON", WS_CHILD | WS_TABSTOP | BS_OWNERDRAW, 0, 0, 80, 16
    CONTROL "", IDC_SUBTITLE_LANGUAGE_OPTIONS, "LISTBOX", WS_CHILD | WS_TABSTOP | LBS_HASSTRINGS | LBS_OWNERDRAWFIXED | LBS_NOINTEGRALHEIGHT, 0, 0, 80, 48
    CONTROL "", IDC_SUBTITLE_STATUS, "STATIC", WS_CHILD | WS_CLIPSIBLINGS | SS_NOPREFIX, 0, 0, 120, 18
    CONTROL "", IDC_SUBTITLE_RESULTS, "LISTBOX", WS_CHILD | WS_CLIPSIBLINGS | WS_TABSTOP | LBS_HASSTRINGS | LBS_OWNERDRAWFIXED | LBS_NOINTEGRALHEIGHT | LBS_NOTIFY, 0, 0, 120, 48
    CONTROL "", IDC_SUBTITLE_FOLDER_RESULTS, "LISTBOX", WS_CHILD | WS_CLIPSIBLINGS | WS_TABSTOP | LBS_HASSTRINGS | LBS_OWNERDRAWFIXED | LBS_NOINTEGRALHEIGHT, 0, 0, 120, 48
    CONTROL "", IDC_OPENSUBTITLES_KEY, "EDIT", WS_CHILD | WS_CLIPSIBLINGS | WS_TABSTOP | ES_AUTOHSCROLL | ES_PASSWORD, 0, 0, 100, 16
    CONTROL "Save API Key", IDC_SAVE_OPENSUBTITLES_KEY, "BUTTON", WS_CHILD | WS_CLIPSIBLINGS | WS_TABSTOP | BS_OWNERDRAW, 0, 0, 80, 16
    CONTROL "Load More", IDC_MORE_SUBTITLES, "BUTTON", WS_CHILD | WS_CLIPSIBLINGS | WS_TABSTOP | BS_OWNERDRAW, 0, 0, 55, 16
    CONTROL "Browse...", IDC_BROWSE_SUBTITLE, "BUTTON", WS_CHILD | WS_CLIPSIBLINGS | WS_TABSTOP | BS_OWNERDRAW, 0, 0, 55, 16
    CONTROL "Cancel", IDCANCEL, "BUTTON", WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_OWNERDRAW, 0, 0, 40, 16
    CONTROL "Save", IDOK, "BUTTON", WS_CHILD | WS_VISIBLE | WS_DISABLED | WS_TABSTOP | BS_OWNERDRAW, 0, 0, 40, 16
    CONTROL "Close", IDC_CLOSE_ADD_SUBTITLES, "BUTTON", WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_OWNERDRAW, 0, 0, 16, 16
END
